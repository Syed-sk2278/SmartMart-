<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7FBFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header -->

        <TextView
            android:id="@+id/tvReceiptTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="SmartMart+"
            android:textColor="#087F72"
            android:textSize="32sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Digital Receipt"
            android:textColor="#52656C"
            android:textSize="20sp" />

        <!-- Success -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="✓ Payment Successful"
            android:textColor="#087F72"
            android:textSize="21sp"
            android:textStyle="bold" />

        <!-- Receipt Card -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="#E2F2EF"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/tvReceiptNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Receipt No: SM000000"
                android:textColor="#263238"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvReceiptDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Date: --"
                android:textColor="#52656C"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/tvReceiptItems"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Items: 0"
                android:textColor="#263238"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Subtotal -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginTop="22dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Subtotal"
                android:textColor="#52656C"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvReceiptSubtotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="#101C25"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Discount -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Discount"
                android:textColor="#52656C"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvReceiptDiscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="- ₹0.00"
                android:textColor="#087F72"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- GST -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="GST"
                android:textColor="#52656C"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/tvReceiptGST"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="#101C25"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Total -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="10dp"
            android:background="#D5ECE7"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Total Paid"
                android:textColor="#087F72"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvReceiptTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="₹0.00"
                android:textColor="#087F72"
                android:textSize="25sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Payment Method -->

        <TextView
            android:id="@+id/tvReceiptPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:text="Payment Method: UPI"
            android:textColor="#37474F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <!-- Done -->

        <Button
            android:id="@+id/btnDone"
            android:layout_width="match_parent"
            android:layout_height="62dp"
            android:layout_marginTop="28dp"
            android:backgroundTint="#087F72"
            android:text="Done"
            android:textColor="#FFFFFF"
            android:textSize="19sp"
            android:textStyle="bold" />

        <!-- Home -->

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#DCEDEA"
            android:text="Back to Home"
            android:textColor="#087F72"
            android:textSize="18sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F3F7FF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- HEADER -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:text="SmartMart+"
            android:textColor="#1D347F"
            android:textSize="34sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:gravity="center"
            android:text="STAFF ADMIN DASHBOARD"
            android:textColor="#7180A6"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- WELCOME CARD -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="👋  Welcome, Staff"
                android:textColor="#1D347F"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Manage store verification and customer exit checks."
                android:textColor="#68758F"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- EXIT VERIFICATION -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#DDF6E9"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🛡️  Exit Verification"
                android:textColor="#08704F"
                android:textSize="23sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Scan the customer's payment QR code before they leave the store."
                android:textColor="#4B756B"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnExitVerification"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="18dp"
                android:backgroundTint="#08704F"
                android:text="📷  Open Exit Verification"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- FUTURE ADMIN FEATURES -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Admin Features"
            android:textColor="#1D347F"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:text="📊  Sales &amp; Monthly Reports&#10;&#10;👥  Customer Activity&#10;&#10;⏰  Peak Shopping Hours&#10;&#10;🧾  Transaction Monitoring"
            android:textColor="#5E6B82"
            android:textSize="15sp" />

        <!-- BACK -->

        <Button
            android:id="@+id/btnAdminBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="20dp"
            android:backgroundTint="#E3E9F8"
            android:text="Back"
            android:textAllCaps="false"
            android:textColor="#1D347F"
            android:textSize="16sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
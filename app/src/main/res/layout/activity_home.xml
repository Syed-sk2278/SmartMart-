<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FFFDF8">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <!-- ================================================= -->
            <!-- HEADER -->
            <!-- ================================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="28dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvUserName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Welcome back, SmartMart User"
                            android:textColor="#0A4350"
                            android:textSize="27sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Good things, everyday! ♡"
                            android:textColor="#164F59"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvProfileCircle"
                        android:layout_width="58dp"
                        android:layout_height="58dp"
                        android:gravity="center"
                        android:text="SM"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:background="@drawable/home_profile_bg" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="35dp"
                        android:layout_height="35dp"
                        android:gravity="center"
                        android:text="★"
                        android:textColor="#F5BD1F"
                        android:textSize="27sp" />

                    <TextView
                        android:id="@+id/tvPoints"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:paddingStart="10dp"
                        android:paddingEnd="10dp"
                        android:text="⭐ Smart Points 120"
                        android:textColor="#173E4C"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- SELECTED STORE -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutSelectedStore"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:background="@drawable/home_card_bg"
                android:backgroundTint="#EEE5FF"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:gravity="center"
                    android:text="🏪"
                    android:textSize="36sp"
                    android:background="@drawable/home_purple_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Selected Store"
                        android:textColor="#51469A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvStoreName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="SmartMart+ Main Store"
                        android:textColor="#17156B"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvChangeStore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Change Store ›"
                        android:textColor="#5635D0"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                </LinearLayout>

                <TextView
                    android:layout_width="65dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="📍&#10;Your favourite&#10;store ♡"
                    android:textColor="#26205F"
                    android:textSize="11sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- BEFORE STORE -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutBeforeStore"
                android:layout_width="match_parent"
                android:layout_height="115dp"
                android:layout_marginTop="14dp"
                android:background="#D8F4E8"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <TextView
                    android:layout_width="70dp"
                    android:layout_height="70dp"
                    android:gravity="center"
                    android:text="🛍️"
                    android:textSize="37sp"
                    android:background="@drawable/home_green_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="13dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Before you enter the store"
                        android:textColor="#075448"
                        android:textSize="19sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="5dp"
                        android:text="Plan ahead for a smarter&#10;shopping experience."
                        android:textColor="#4B756B"
                        android:textSize="14sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- INSIDE STORE -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutInsideStore"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Inside Store Confirmation -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="82dp"
                    android:background="#D5F5E8"
                    android:gravity="center_vertical"
                    android:paddingStart="18dp">

                    <TextView
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:gravity="center"
                        android:text="✓"
                        android:textColor="#FFFFFF"
                        android:textSize="34sp"
                        android:textStyle="bold"
                        android:background="@drawable/home_green_circle" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="13dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="You are inside the store!"
                            android:textColor="#075448"
                            android:textSize="19sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Self-billing features are now available."
                            android:textColor="#4B756B"
                            android:textSize="13sp" />

                    </LinearLayout>

                </LinearLayout>


                <!-- Inside Store Title -->

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Once you're inside the store"
                    android:textColor="#0B4050"
                    android:textSize="22sp"
                    android:textStyle="bold" />


                <!-- Scan Product -->

                <Button
                    android:id="@+id/btnScanner"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/home_card_bg"
                    android:backgroundTint="#C9F3DF"
                    android:text="📷   Scan Product                                      ›"
                    android:textAllCaps="false"
                    android:textColor="#08765A"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- My Cart -->

                <Button
                    android:id="@+id/btnCart"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/home_card_bg"
                    android:backgroundTint="#E2D2FF"
                    android:text="🛒   My Cart                                            ›"
                    android:textAllCaps="false"
                    android:textColor="#5030B7"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- Store Map -->

                <Button
                    android:id="@+id/btnMap"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/home_card_bg"
                    android:backgroundTint="#FFE0AD"
                    android:text="🗺️   Store Map                                      ›"
                    android:textAllCaps="false"
                    android:textColor="#A84D0C"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- Billing -->

                <Button
                    android:id="@+id/btnBilling"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/home_card_bg"
                    android:backgroundTint="#C9E7FA"
                    android:text="🧾   Billing                                            ›"
                    android:textAllCaps="false"
                    android:textColor="#145D9E"
                    android:textSize="16sp"
                    android:textStyle="bold" />


                <!-- Payment -->

                <Button
                    android:id="@+id/btnPayment"
                    android:layout_width="match_parent"
                    android:layout_height="62dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/home_card_bg"
                    android:backgroundTint="#F9CFE0"
                    android:text="💳   Payment                                         ›"
                    android:textAllCaps="false"
                    android:textColor="#A61559"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- YOUR SMARTMART+ -->
            <!-- ================================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="Your SmartMart+"
                android:textColor="#0B4050"
                android:textSize="24sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Plan your shopping and keep track of your purchases."
                android:textColor="#52717C"
                android:textSize="14sp" />


            <!-- ================================================= -->
            <!-- SHOPPING LIST -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardShoppingList"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/home_card_bg"
                android:backgroundTint="#FFF0C7"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:gravity="center"
                    android:text="🛒"
                    android:textSize="31sp"
                    android:background="@drawable/home_green_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Shopping List"
                        android:textColor="#075448"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- DYNAMIC COUNT -->

                    <TextView
                        android:id="@+id/tvShoppingListCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 items"
                        android:textColor="#57746D"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#07805E"
                    android:textSize="31sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- PURCHASE HISTORY -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardPurchaseHistory"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/home_card_bg"
                android:backgroundTint="#D8EEFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:gravity="center"
                    android:text="🧾"
                    android:textSize="31sp"
                    android:background="@drawable/home_blue_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Purchase History"
                        android:textColor="#174DA3"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- DYNAMIC ORDER COUNT -->

                    <TextView
                        android:id="@+id/tvPurchaseHistoryCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Orders"
                        android:textColor="#58718A"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#1769AA"
                    android:textSize="31sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- OFFERS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardOffers"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/home_offer_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:gravity="center"
                    android:text="🎁"
                    android:textSize="31sp"
                    android:background="@drawable/home_pink_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Offers"
                        android:textColor="#A30D4F"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 Active Offers"
                        android:textColor="#8B5A6F"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#C2185B"
                    android:textSize="31sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- MONTHLY SUMMARY -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/cardSummary"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/home_card_bg"
                android:backgroundTint="#E8DDFF"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <TextView
                    android:layout_width="62dp"
                    android:layout_height="62dp"
                    android:gravity="center"
                    android:text="📊"
                    android:textSize="31sp"
                    android:background="@drawable/home_purple_circle" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="12dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Monthly Summary"
                        android:textColor="#4E2DA8"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Spent ₹0"
                        android:textColor="#75659B"
                        android:textSize="14sp" />

                </LinearLayout>

                <TextView
                    android:layout_width="30dp"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="#6840C2"
                    android:textSize="31sp" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- STORE QR -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutStoreQR"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/home_qr_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp">

                <TextView
                    android:layout_width="55dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="▦"
                    android:textColor="#FFFFFF"
                    android:textSize="30sp" />

                <Button
                    android:id="@+id/btnStoreQR"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:text="Scan Store Entrance QR   ›"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ================================================= -->
            <!-- QUICK ACCESS -->
            <!-- ================================================= -->

            <LinearLayout
                android:id="@+id/layoutQuickAccess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvQuickAccess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="⚡ Quick Access"
                    android:textColor="#0B4050"
                    android:textSize="21sp"
                    android:textStyle="bold" />


                <!-- QUICK ACCESS ROW 1 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnHelp"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginTop="7dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/home_small_button"
                        android:backgroundTint="#D5ECFF"
                        android:text="🎧  Help &amp;&#10;Support   ›"
                        android:textAllCaps="false"
                        android:textColor="#1769AA"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnEmergency"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginTop="7dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/home_small_button"
                        android:backgroundTint="#FFD6D6"
                        android:text="🚨  Emergency&#10;Assistance   ›"
                        android:textAllCaps="false"
                        android:textColor="#C62828"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>


                <!-- QUICK ACCESS ROW 2 -->

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="65dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btnLostFound"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginTop="2dp"
                        android:layout_marginEnd="4dp"
                        android:background="@drawable/home_small_button"
                        android:backgroundTint="#FFF1B8"
                        android:text="🔎  Lost &amp;&#10;Found   ›"
                        android:textAllCaps="false"
                        android:textColor="#947000"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btnReport"
                        android:layout_width="0dp"
                        android:layout_height="58dp"
                        android:layout_weight="1"
                        android:layout_marginTop="2dp"
                        android:layout_marginStart="4dp"
                        android:background="@drawable/home_small_button"
                        android:backgroundTint="#E8D9FF"
                        android:text="📝  Report an&#10;Activity   ›"
                        android:textAllCaps="false"
                        android:textColor="#7040A8"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                </LinearLayout>

            </LinearLayout>


            <!-- ================================================= -->
            <!-- LOGOUT -->
            <!-- ================================================= -->

            <Button
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="58dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/home_logout_bg"
                android:text="⇥   Logout"
                android:textAllCaps="false"
                android:textColor="#D51D58"
                android:textSize="16sp"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/login_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="20dp">

        <!-- Logo -->

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="35dp">

            <ImageView
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/smartmart_logo"
                android:scaleType="fitCenter"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SmartMart+"
                    android:textColor="#33B8FF"
                    android:textSize="32sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI Powered Smart Self Billing System"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>

            </LinearLayout>

        </LinearLayout>

        <!-- Welcome -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Welcome!"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:layout_marginTop="35dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Login Successful"
            android:textColor="#D9D9D9"
            android:textSize="16sp"
            android:layout_marginBottom="30dp"/>

        <!-- Customer Dashboard -->

        <Button
            android:id="@+id/btnPlanner"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/edittext_bg"
            android:text="Shopping Planner"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/btnScanner"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/edittext_bg"
            android:text="Barcode Scanner"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/btnCart"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/edittext_bg"
            android:text="My Cart"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="18sp"/>

        <Button
            android:id="@+id/btnOffers"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="15dp"
            android:background="@drawable/edittext_bg"
            android:text="Offers"
            android:textColor="#FFFFFF"
            android:textAllCaps="false"
            android:textSize="18sp"/>

        <!-- Logout -->

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="30dp"
            android:background="@drawable/login_button"
            android:text="Logout"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>

    </LinearLayout>

</ScrollView>
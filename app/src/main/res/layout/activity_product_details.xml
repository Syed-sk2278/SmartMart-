<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1026"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ========================= -->
        <!-- TOP HEADER -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="90dp"
            android:background="#111936"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#FFFFFF"
                android:textSize="38sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SmartMart+"
                    android:textColor="#5BC5FF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Product Details"
                    android:textColor="#FFFFFF"
                    android:textSize="23sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCartIcon"
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:background="#202957"
                android:gravity="center"
                android:text="🛒"
                android:textSize="21sp" />

        </LinearLayout>


        <!-- ========================= -->
        <!-- CONTENT -->
        <!-- ========================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">


            <!-- ========================= -->
            <!-- PRODUCT IMAGE CARD -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="270dp"
                android:background="#151D40"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgProduct"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:contentDescription="Product image"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_launcher_foreground" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- AVAILABILITY -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/tvAvailability"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginTop="18dp"
                android:background="#173D36"
                android:gravity="center"
                android:paddingStart="15dp"
                android:paddingEnd="15dp"
                android:text="✓  In Stock"
                android:textColor="#50E3A4"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- ========================= -->
            <!-- PRODUCT NAME -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/tvProductName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:text="Product Name"
                android:textColor="#FFFFFF"
                android:textSize="25sp"
                android:textStyle="bold" />


            <!-- BRAND -->
            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="Brand: Amul"
                android:textColor="#AAB3D2"
                android:textSize="15sp" />


            <!-- ========================= -->
            <!-- PRICE -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/tvPrice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="₹61.00"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold" />


            <!-- GST + DISCOUNT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvGst"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_weight="1"
                    android:background="#151D40"
                    android:gravity="center"
                    android:text="GST: 5%"
                    android:textColor="#AAB3D2"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/tvDiscount"
                    android:layout_width="0dp"
                    android:layout_height="45dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="#173D36"
                    android:gravity="center"
                    android:text="Discount: 3%"
                    android:textColor="#50E3A4"
                    android:textSize="14sp" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- STOCK -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/tvStock"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="15dp"
                android:background="#151D40"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Stock: 10"
                android:textColor="#FFFFFF"
                android:textSize="15sp" />


            <!-- ========================= -->
            <!-- PRODUCT LOCATION -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:layout_marginTop="12dp"
                android:background="#151D40"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="#173D36"
                    android:gravity="center"
                    android:text="📍"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/tvShelf"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:text="Shelf: Aisle 3 • Shelf 2"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

            </LinearLayout>


            <!-- ========================= -->
            <!-- OFFER -->
            <!-- ========================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="75dp"
                android:layout_marginTop="15dp"
                android:background="#302B17"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="15dp">

                <TextView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:gravity="center"
                    android:text="🏷"
                    android:textSize="21sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available Offer"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="Discount applied on this product"
                        android:textColor="#C8B96A"
                        android:textSize="12sp" />

                </LinearLayout>

            </LinearLayout>


            <!-- ========================= -->
            <!-- PRODUCT INFORMATION -->
            <!-- ========================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Product Information"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="#151D40"
                android:padding="16dp"
                android:text="Product description"
                android:textColor="#AAB3D2"
                android:textSize="14sp" />


            <!-- ========================= -->
            <!-- BARCODE -->
            <!-- ========================= -->

            <TextView
                android:id="@+id/tvBarcode"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:background="#151D40"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:text="Barcode: 8901262100018"
                android:textColor="#AAB3D2"
                android:textSize="13sp" />


            <!-- ========================= -->
            <!-- ADD TO CART -->
            <!-- ========================= -->

            <Button
                android:id="@+id/btnAddToCart"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="25dp"
                android:backgroundTint="#4267E8"
                android:text="🛒  Add to Cart"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
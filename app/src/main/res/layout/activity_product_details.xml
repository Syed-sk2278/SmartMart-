<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FBFA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="22dp">

        <!-- ========================================= -->
        <!-- HEADER                                    -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="18dp">

            <TextView
                android:id="@+id/tvBack"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:gravity="center"
                android:text="‹"
                android:textColor="#087F73"
                android:textSize="48sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SmartMart+"
                    android:textColor="#087F73"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Product Details"
                    android:textColor="#101C25"
                    android:textSize="30sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvCartIcon"
                android:layout_width="65dp"
                android:layout_height="65dp"
                android:background="#DDEFEA"
                android:gravity="center"
                android:text="🛒"
                android:textSize="30sp" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- PRODUCT IMAGE AREA                        -->
        <!-- ========================================= -->

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:background="#E7F3F0"
            android:padding="15dp">

            <ImageView
                android:id="@+id/imgProduct"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Product image"
                android:scaleType="fitCenter"
                android:src="@android:drawable/ic_menu_gallery" />

        </FrameLayout>


        <!-- ========================================= -->
        <!-- STOCK STATUS                               -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/tvStockStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:background="#D9EFE9"
            android:paddingLeft="22dp"
            android:paddingTop="14dp"
            android:paddingRight="22dp"
            android:paddingBottom="14dp"
            android:text="✓  In Stock"
            android:textColor="#087F73"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- ========================================= -->
        <!-- PRODUCT NAME                               -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/tvProductName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Product"
            android:textColor="#101C25"
            android:textSize="36sp"
            android:textStyle="bold" />


        <!-- ========================================= -->
        <!-- BRAND                                     -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/tvBrand"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Brand: N/A"
            android:textColor="#63737A"
            android:textSize="22sp" />


        <!-- ========================================= -->
        <!-- PRICE                                     -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="₹0.00"
            android:textColor="#087F73"
            android:textSize="40sp"
            android:textStyle="bold" />


        <!-- ========================================= -->
        <!-- GST + DISCOUNT                             -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvGst"
                android:layout_width="0dp"
                android:layout_height="85dp"
                android:layout_marginRight="8dp"
                android:layout_weight="1"
                android:background="#E3F1EE"
                android:gravity="center"
                android:text="GST: 0%"
                android:textColor="#087F73"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvDiscount"
                android:layout_width="0dp"
                android:layout_height="85dp"
                android:layout_marginLeft="8dp"
                android:layout_weight="1"
                android:background="#D9EFE9"
                android:gravity="center"
                android:text="Discount: 0%"
                android:textColor="#087F73"
                android:textSize="20sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- STOCK                                     -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/tvStockInfo"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:gravity="center_vertical"
            android:paddingLeft="22dp"
            android:text="Stock"
            android:textColor="#101C25"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- ========================================= -->
        <!-- SHELF                                     -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/tvShelf"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#FFFFFF"
            android:padding="22dp"
            android:text="Shelf: N/A"
            android:textColor="#35464D"
            android:textSize="20sp" />


        <!-- ========================================= -->
        <!-- OFFER                                     -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/tvOffer"
            android:layout_width="match_parent"
            android:layout_height="75dp"
            android:layout_marginTop="18dp"
            android:background="#D9EFE9"
            android:gravity="center_vertical"
            android:paddingLeft="25dp"
            android:text="Available Offer                         ›"
            android:textColor="#087F73"
            android:textSize="21sp"
            android:textStyle="bold" />


        <!-- ========================================= -->
        <!-- DESCRIPTION                               -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/tvDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="No description available"
            android:textColor="#52656C"
            android:textSize="20sp" />


        <!-- ========================================= -->
        <!-- BARCODE                                   -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/tvBarcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Barcode: N/A"
            android:textColor="#7B898E"
            android:textSize="18sp" />


        <!-- ========================================= -->
        <!-- ADD TO CART                               -->
        <!-- ========================================= -->

        <Button
            android:id="@+id/btnAddToCart"
            android:layout_width="match_parent"
            android:layout_height="65dp"
            android:layout_marginTop="25dp"
            android:backgroundTint="#087F73"
            android:text="Add to Cart"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />


        <!-- ========================================= -->
        <!-- VIEW CART                                 -->
        <!-- ========================================= -->

        <Button
            android:id="@+id/btnViewCart"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#D9EFE9"
            android:text="🛒  View Cart"
            android:textColor="#087F73"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </LinearLayout>

</ScrollView>
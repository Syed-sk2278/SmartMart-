<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F3EA"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="32dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <!-- ========================================= -->
        <!-- HEADER -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗺️ Store Map"
                android:textColor="#123B63"
                android:textSize="28sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Find products and move around the store easily"
                android:textColor="#666666"
                android:textSize="14sp" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- ENTRANCE -->
        <!-- ========================================= -->

        <TextView
            android:id="@+id/mapEntrance"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/store_map_entrance_bg"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="🚪  ENTRANCE"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- ========================================= -->
        <!-- STORE MAP -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#FFFFFF"
            android:elevation="4dp"
            android:orientation="vertical"
            android:padding="14dp">


            <!-- ========================================= -->
            <!-- DAIRY + SNACKS -->
            <!-- ========================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mapDairy"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/store_map_blue_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🥛&#10;DAIRY"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mapSnacks"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/store_map_green_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🍪&#10;SNACKS"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ========================================= -->
            <!-- BEVERAGES + PERSONAL CARE -->
            <!-- ========================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mapBeverages"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/store_map_orange_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🥤&#10;BEVERAGES"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mapPersonalCare"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/store_map_purple_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🧴&#10;PERSONAL CARE"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ========================================= -->
            <!-- HOUSEHOLD + GROCERIES -->
            <!-- ========================================= -->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="76dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/mapHousehold"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/store_map_teal_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🧹&#10;HOUSEHOLD"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/mapFreshFood"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="7dp"
                    android:layout_weight="1"
                    android:background="@drawable/store_map_red_bg"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:text="🛒&#10;GROCERIES"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </LinearLayout>


            <!-- ========================================= -->
            <!-- WALKWAY -->
            <!-- ========================================= -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:background="#EAF0F5"
                android:gravity="center"
                android:text="↓   MAIN SHOPPING WALKWAY   ↓"
                android:textColor="#123B63"
                android:textSize="14sp"
                android:textStyle="bold" />


            <!-- ========================================= -->
            <!-- BILLING -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/mapBilling"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/store_map_checkout_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="💳  BILLING / CHECKOUT"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />


            <!-- ========================================= -->
            <!-- EXIT -->
            <!-- ========================================= -->

            <TextView
                android:id="@+id/mapExit"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/store_map_exit_bg"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:text="🚶  EXIT"
                android:textColor="#FFFFFF"
                android:textSize="17sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- STORE SECTIONS -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Store Sections"
            android:textColor="#123B63"
            android:textSize="22sp"
            android:textStyle="bold" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="16dp">


            <!-- DAIRY -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:text="🥛  Dairy"
                android:textColor="#444444"
                android:textSize="15sp" />


            <!-- SNACKS -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:text="🍪  Snacks"
                android:textColor="#444444"
                android:textSize="15sp" />


            <!-- BEVERAGES -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:text="🥤  Beverages"
                android:textColor="#444444"
                android:textSize="15sp" />


            <!-- PERSONAL CARE -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:text="🧴  Personal Care"
                android:textColor="#444444"
                android:textSize="15sp" />


            <!-- HOUSEHOLD -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:text="🧹  Household"
                android:textColor="#444444"
                android:textSize="15sp" />


            <!-- GROCERIES -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:text="🛒  Groceries"
                android:textColor="#444444"
                android:textSize="15sp" />


            <!-- BILLING -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:text="💳  Billing / Checkout"
                android:textColor="#444444"
                android:textSize="15sp" />


            <!-- EXIT -->

            <TextView
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:gravity="center_vertical"
                android:text="🚶  Exit"
                android:textColor="#444444"
                android:textSize="15sp" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- BACK TO HOME -->
        <!-- ========================================= -->

        <Button
            android:id="@+id/btnBackHome"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="36dp"
            android:backgroundTint="#123B63"
            android:text="←  Back to Home"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
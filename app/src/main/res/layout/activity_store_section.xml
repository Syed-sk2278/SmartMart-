<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F3EA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">


        <!-- ========================================= -->
        <!-- SECTION HEADER -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="35dp"
            android:paddingBottom="25dp">

            <TextView
                android:id="@+id/tvSectionIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍪"
                android:textSize="70sp" />

            <TextView
                android:id="@+id/tvSectionName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Snacks"
                android:textColor="#123B63"
                android:textSize="38sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvSectionStore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="📍 SmartMart+ Store"
                android:textColor="#777777"
                android:textSize="17sp" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- ABOUT -->
        <!-- ========================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="About this section"
                android:textColor="#123B63"
                android:textSize="25sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvAboutText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Browse products available in this section."
                android:textColor="#555555"
                android:textSize="17sp"
                android:lineSpacingExtra="5dp" />

        </LinearLayout>


        <!-- ========================================= -->
        <!-- PRODUCTS TITLE -->
        <!-- ========================================= -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="🛒  Products in this section"
            android:textColor="#123B63"
            android:textSize="25sp"
            android:textStyle="bold" />


        <!-- ========================================= -->
        <!-- PRODUCTS -->
        <!-- ========================================= -->

        <LinearLayout
            android:id="@+id/productsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />


        <!-- ========================================= -->
        <!-- BACK -->
        <!-- ========================================= -->

        <Button
            android:id="@+id/btnBackMap"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="35dp"
            android:backgroundTint="#123B63"
            android:text="←  Back to Store Map"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
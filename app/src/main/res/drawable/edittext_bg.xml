<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Transparent background -->
    <solid android:color="#00000000"/>

    <!-- Rounded corners -->
    <corners android:radius="20dp"/>

    <!-- Border -->
    <stroke
        android:width="1dp"
        android:color="#4C6487"/>

    <!-- Internal padding -->
    <padding
        android:left="16dp"
        android:right="16dp"
        android:top="12dp"
        android:bottom="12dp"/>

</shape>
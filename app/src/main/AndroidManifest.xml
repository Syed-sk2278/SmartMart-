<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet access for Supabase / Retrofit -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera access for ZXing QR and barcode scanner -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="SmartMart+"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartMartPlus">

        <!-- ========================================== -->
        <!-- MAIN ACTIVITY                              -->
        <!-- ========================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================================== -->
        <!-- SPLASH                                     -->
        <!-- ========================================== -->

        <activity
            android:name=".SplashActivity"
            android:exported="false" />


        <!-- ========================================== -->
        <!-- LOGIN                                      -->
        <!-- ========================================== -->

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>

                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />

            </intent-filter>

        </activity>


        <!-- ========================================== -->
        <!-- REGISTER                                   -->
        <!-- ========================================== -->

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================================== -->
        <!-- PLANNER                                    -->
        <!-- ========================================== -->

        <activity
            android:name=".PlannerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================================== -->
        <!-- HOME                                       -->
        <!-- ========================================== -->

        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================================== -->
        <!-- STORE ENTRANCE QR SCANNER                  -->
        <!-- ========================================== -->

        <activity
            android:name=".StoreQRScannerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================================== -->
        <!-- OTHER SCANNER                              -->
        <!-- ========================================== -->

        <activity
            android:name=".ScannerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================================== -->
        <!-- PRODUCT BARCODE SCANNER                    -->
        <!-- ========================================== -->

        <activity
            android:name=".BarcodeScannerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================================== -->
        <!-- PRODUCT DETAILS                            -->
        <!-- ========================================== -->

        <activity
            android:name=".ProductDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================================== -->
        <!-- CART                                       -->
        <!-- ========================================== -->

        <activity
            android:name=".CartActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================================== -->
        <!-- PAYMENT                                    -->
        <!-- ========================================== -->

        <activity
            android:name=".PaymentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================================== -->
        <!-- RECEIPT                                    -->
        <!-- ========================================== -->

        <activity
            android:name=".ReceiptActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />


        <!-- ========================================== -->
        <!-- ADMIN                                      -->
        <!-- ========================================== -->

        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>
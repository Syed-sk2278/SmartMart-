<?xml version="1.0" encoding="utf-8"?>

<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Internet access for Supabase / Retrofit -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Camera permission for QR and barcode scanning -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Camera hardware is optional -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="SmartMart+"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartMartPlus">

        <!-- Main Activity -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Splash Screen -->
        <activity
            android:name=".SplashActivity"
            android:exported="false" />

        <!-- Login Screen -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- Forgot Password -->
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Register Screen -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Planner -->
        <activity
            android:name=".PlannerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Home -->
        <activity
            android:name=".HomeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Shopping List -->
        <activity
            android:name=".ShoppingListActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Store Entrance QR Scanner -->
        <activity
            android:name=".StoreQRScannerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Scanner Activity -->
        <activity
            android:name=".ScannerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Product Barcode Scanner -->
        <activity
            android:name=".BarcodeScannerActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Product Details -->
        <activity
            android:name=".ProductDetailsActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Cart -->
        <activity
            android:name=".CartActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Payment -->
        <activity
            android:name=".PaymentActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Receipt -->
        <activity
            android:name=".ReceiptActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- Purchase History -->
        <activity
            android:name=".PurchaseHistoryActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Admin -->
        <activity
            android:name=".AdminActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>